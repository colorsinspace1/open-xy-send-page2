+void sdk_fx_post(u32, opxy::i32*, opxy::i32*) {}
+// Stock's mixer queries a send's dry level from two call sites; the one for
+// send B (CALL (P1) at 8d510df4, returning to 8d510df6) applies the answer
+// inverted, so it is reported inverted. The call site is identified by the
+// query's return address, not by any object or vector the mixer passes.
+opxy::i32 sdk_fx_dry(opxy::i32 value, const void* from) __asm__("sdk_fx_dry");
+opxy::i32 sdk_fx_dry(opxy::i32 value, const void* from) {
+    if (value < 0) value = 0;
+    return reinterpret_cast<opxy::platform::Address>(from) == 0x8d510df6u ? 0x7fffffff - value : value;
+}
+// The parameter slot a send page position edits and names.
