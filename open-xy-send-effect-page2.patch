+// Send effects with five to eight controls: the stock send page edits only the
+// first four positions. Holding encoder 1 and turning it switches the page.
+// Page 2 edits slots 4..7 through stock's own parameter path (stored, stepped
+// and published to the audio vector by stock), so the effect receives them
+// unchanged. Page 2's value text reads the stored slot. Nothing here writes
+// stock's vector directly.
+static bool fx_page_two[2] = {false, false};
+static u32 fx_engine[2] = {0, 0};
+static u32 fx_project = 0x86bd027c;   // stock's project, as the LFO page uses it
+static bool fx_on_page_two(u32 track) {
+    const u32 t = track - 14;
+    if (fx_page_two[t] && track_engine(track) != fx_engine[t]) fx_page_two[t] = false;
+    return fx_page_two[t];
+}
+static void fx_switch_page(u32 track, bool page_two) {
+    const u32 t = track - 14;
+    if (fx_on_page_two(track) == page_two) return;
+    if (page_two) fx_engine[t] = track_engine(track);
+    fx_page_two[t] = page_two;
+}
